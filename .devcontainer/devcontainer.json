{
  "name": "Pixeltable Starter Kit",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // No forwardPorts: `pxt service update` binds an OS-assigned port, and VS Code
  // auto-forwards whatever the service ends up listening on.

  "mounts": [
    "source=pixeltable-data,target=/home/vscode/.pixeltable,type=volume"
  ],

  "containerEnv": {
    "PIXELTABLE_HOME": "/home/vscode/.pixeltable"
  },

  // Listed on the codespace creation page; leaving it empty is fine.
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Optional. Only the chat agent's /ask route needs it.",
      "documentationUrl": "https://console.anthropic.com/settings/keys"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/chat-agent/.venv/bin/python"
      }
    }
  }
}
